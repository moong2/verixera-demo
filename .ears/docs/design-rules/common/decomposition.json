{
  "schema": "design-rules/v1",
  "layer": "common",
  "id": "common-decomposition",
  "version": "1.0",
  "note": "분할 규칙 — 설계 에이전트가 분할·통합 후보와 근거를 만들 때 쓴다(명령이 아니다). 판정 대상이 아니다. 출처: 사용자 제안(2026-11-26), 자체 정책.",
  "rules": [
    { "rule_id": "DEC-01", "rule_version": "1.0", "name": "책임이 다르면 분할 검토", "purpose": "DECOMPOSITION", "rule_type": "DESIGN_POLICY", "enforcement": "ADVISORY", "design_stage": "ARCHITECTURE", "check_method": "AI_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책" }, "text": "서로 다른 기능적 책임(예: 신호 처리, 판단, 출력)은 다른 유닛으로 나누는 것을 검토한다." },
    { "rule_id": "DEC-02", "rule_version": "1.0", "name": "실행 주기가 다르면 실행 구조 분리 검토", "purpose": "DECOMPOSITION", "rule_type": "DESIGN_POLICY", "enforcement": "ADVISORY", "design_stage": "ARCHITECTURE", "check_method": "AI_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책" }, "text": "요구사항이 말하는 실행 주기·이벤트·마감 시간이 다르면 실행 구조(유닛·태스크)를 나누는 것을 검토한다. 요구사항에 주기가 없으면 지어내지 않는다." },
    { "rule_id": "DEC-03", "rule_version": "1.0", "name": "고장 대응·안전 기능은 별도 요소 또는 격리 검토", "purpose": "DECOMPOSITION", "rule_type": "DESIGN_POLICY", "enforcement": "ADVISORY", "design_stage": "ARCHITECTURE", "check_method": "AI_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책" }, "text": "독립적인 고장 대응·안전 기능은 별도 유닛으로 두거나 격리가 필요한지 검토한다." },
    { "rule_id": "DEC-04", "rule_version": "1.0", "name": "내부 상태를 밀접하게 공유하면 통합 유지 검토", "purpose": "DECOMPOSITION", "rule_type": "DESIGN_POLICY", "enforcement": "ADVISORY", "design_stage": "ARCHITECTURE", "check_method": "AI_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책" }, "text": "같은 내부 상태를 함께 읽고 쓰는 동작은 한 유닛에 두는 것을 검토한다(상태를 유닛 사이 신호로 흩뜨리지 않는다)." },
    { "rule_id": "DEC-05", "rule_version": "1.0", "name": "하나의 기능을 이루는 여러 함수는 한 유닛", "purpose": "DECOMPOSITION", "rule_type": "DESIGN_POLICY", "enforcement": "ADVISORY", "design_stage": "DETAILED", "check_method": "AI_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "standard": "Automotive SPICE 4.0", "clause": "SWE.3.BP1 Note 1 (p.49)", "url": "https://vda-qmc.de/wp-content/uploads/2023/12/Automotive-SPICE-PAM-v40.pdf", "review_status": "SOURCE_CHECKED", "checked_by": "사용자 조사(2026-11-26)", "note": "유닛 경계는 코드·파일 구조와 독립, 응용 도메인의 의미로 정하며 여러 함수로 구현 가능 — 원문 확인은 사용자, 자체 규칙의 의미 검토는 미완" }, "text": "여러 하위 함수가 하나의 기능을 완성하면 같은 유닛으로 묶을 수 있다. 유닛 경계는 파일이나 함수 개수가 아니라 기능의 의미로 정한다." },
    { "rule_id": "DEC-06", "rule_version": "1.0", "name": "독립 시험이 어려우면 경계 재설계", "purpose": "DECOMPOSITION", "rule_type": "DESIGN_POLICY", "enforcement": "ADVISORY", "design_stage": "INTERFACE", "check_method": "AI_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책" }, "text": "유닛을 따로 떼어 입력을 넣고 출력을 볼 수 없으면 경계와 인터페이스를 다시 설계한다." },
    { "rule_id": "DEC-07", "rule_version": "1.0", "name": "분할로 인터페이스가 과도해지면 통합 검토", "purpose": "DECOMPOSITION", "rule_type": "DESIGN_POLICY", "enforcement": "ADVISORY", "design_stage": "ARCHITECTURE", "check_method": "AI_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책" }, "text": "나눈 결과 유닛 사이 신호가 지나치게 많아지면 통합하거나 구조를 바꾸는 것을 검토한다. 안전등급이 높다고 무조건 더 잘게 나누지 않는다." }
  ]
}
