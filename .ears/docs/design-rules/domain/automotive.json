{
  "schema": "design-rules/v1",
  "layer": "domain",
  "id": "automotive",
  "version": "1.0",
  "applies": { "domains": ["automotive"], "subdomains": ["automotive"] },
  "note": "자동차 프로파일 1차 규칙(AUTO-01~08, 사용자 제안 2026-11-26). 모두 자체 정책 — 원문 대조·의미 검토 뒤 표준 유형으로 바꾼다.",
  "rules": [
    { "rule_id": "AUTO-01", "rule_version": "1.0", "name": "기능 책임 분리", "purpose": "REVIEW", "rule_type": "DESIGN_POLICY", "enforcement": "REVIEW_REQUIRED", "design_stage": "ARCHITECTURE", "check_method": "AI_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책" }, "text": "신호 처리, 제어 판단, 출력 처리의 책임이 유닛마다 명확한가." },
    { "rule_id": "AUTO-02", "rule_version": "1.0", "name": "실행 주기", "purpose": "REVIEW", "rule_type": "DESIGN_POLICY", "enforcement": "ADVISORY", "design_stage": "ARCHITECTURE", "check_method": "HUMAN_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책. 설계 모델에 주기 정보가 아직 없어 사람이 본다. 실제 타이밍은 타깃에서만 확인 가능 — 설계 단계에서 완료로 보지 않음" }, "text": "서로 다른 주기·이벤트·마감 시간을 가진 기능의 실행 구조가 적절한가." },
    { "rule_id": "AUTO-03", "rule_version": "1.0", "name": "안전 요구사항 할당", "purpose": "REVIEW", "rule_type": "DESIGN_POLICY", "enforcement": "BLOCKING", "design_stage": "ARCHITECTURE", "check_method": "FIXED", "fixed_check": "allocation-complete", "deviation_allowed": false, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책. 지금은 요구사항 전체의 할당으로 확인(안전 요구사항 표시는 차후)" }, "text": "안전 요구사항을 포함한 모든 잎 요구사항이 관련 설계 요소에 연결되었는가." },
    { "rule_id": "AUTO-04", "rule_version": "1.0", "name": "간섭 방지", "purpose": "REVIEW", "rule_type": "DESIGN_POLICY", "enforcement": "REVIEW_REQUIRED", "design_stage": "ARCHITECTURE", "check_method": "HUMAN_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책. 설계 모델에 요소별 안전등급이 아직 없어 사람이 본다" }, "text": "서로 다른 안전등급의 요소 사이 간섭 위험을 고려했는가." },
    { "rule_id": "AUTO-05", "rule_version": "1.0", "name": "신호 인터페이스 정의", "purpose": "REVIEW", "rule_type": "DESIGN_POLICY", "enforcement": "BLOCKING", "design_stage": "INTERFACE", "check_method": "FIXED", "fixed_check": "interface-defined", "deviation_allowed": false, "required_for": ["code", "test"], "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책" }, "text": "유닛 사이 인터페이스 신호의 자료형·물리 단위가 정의되었는가(범위·초기값·변환 방식은 사람이 확인)." },
    { "rule_id": "AUTO-06", "rule_version": "1.0", "name": "상태 소유권", "purpose": "REVIEW", "rule_type": "DESIGN_POLICY", "enforcement": "BLOCKING", "design_stage": "DETAILED", "check_method": "FIXED", "fixed_check": "state-owner", "deviation_allowed": false, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책" }, "text": "모드·타이머·카운터·래치(상태 변수)의 소유 유닛·초기값·갱신 책임이 명확한가." },
    { "rule_id": "AUTO-07", "rule_version": "1.0", "name": "유닛별 독립 시험", "purpose": "REVIEW", "rule_type": "DESIGN_POLICY", "enforcement": "REVIEW_REQUIRED", "design_stage": "INTERFACE", "check_method": "FIXED", "fixed_check": "unit-testable", "deviation_allowed": true, "required_for": ["test"], "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책" }, "text": "설계 유닛마다 입력을 제어하고 출력을 관측할 수 있는가." },
    { "rule_id": "AUTO-08", "rule_version": "1.0", "name": "자원 및 타이밍", "purpose": "REVIEW", "rule_type": "DESIGN_POLICY", "enforcement": "ADVISORY", "design_stage": "DETAILED", "check_method": "HUMAN_REVIEW", "deviation_allowed": true, "interpretation_status": "PENDING", "source": { "review_status": "NOT_CHECKED", "note": "자체 정책. CPU 부하·스택·실행시간은 타깃·정적 분석에서만 확인 가능 — 설계 단계에서 완료로 보지 않음" }, "text": "CPU 부하, 스택, 실행시간 등 관련 제약을 고려했는가." }
  ]
}
