{
  "schema": "project-config/v1",
  "domain": "aerospace",
  "standard": "DO-178C",
  "level": "C",
  "basis": "DO-178C 을 참고해 잡은 초기값 — 표준 원문과 프로젝트의 안전·인증 계획으로 확인 필요. 다른 도메인의 등급과 환산한 값이 아님",
  "build": {
    "c_standard": "c11",
    "warnings_as_errors": true,
    "optimization": "-O0",
    "extra_flags": []
  },
  "coding_rules": {
    "single_exit": "required",
    "no_dynamic_memory": "required",
    "initialize_variables": "required",
    "no_duplicate_names": "required",
    "limit_globals": "recommended",
    "restrict_pointers": "required",
    "no_implicit_conversion": "required",
    "no_hidden_flow": "required",
    "no_goto": "required",
    "no_recursion": "recommended",
    "misra_c_2012": "required"
  },
  "test_design": {
    "requirements_analysis": "required",
    "equivalence_classes": "required",
    "boundary_values": "required",
    "error_guessing": "recommended",
    "interface_test": "required",
    "fault_injection": "recommended"
  },
  "coverage": {
    "statement": {
      "level": "required",
      "min": 100
    },
    "branch": {
      "level": "off",
      "min": 100
    },
    "mcdc": {
      "level": "off",
      "min": 100
    }
  }
}
