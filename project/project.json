{
  "schema": "project-config/v1",
  "domain": "automotive",
  "standard": "ISO 26262-6:2018",
  "level": "D",
  "asil": "D",
  "basis": "ISO 26262-6:2018 권고표를 바탕으로 한 초기값 — 표준 원문과 프로젝트 안전 계획으로 확인 필요",
  "build": {
    "compiler": "gcc-14",
    "c_standard": "c11",
    "warnings_as_errors": true,
    "optimization": "-O0",
    "extra_flags": []
  },
  "coding_rules": {
    "single_exit": "required",
    "no_dynamic_memory": "required",
    "initialize_variables": "required",
    "no_duplicate_names": "required",
    "limit_globals": "required",
    "restrict_pointers": "required",
    "no_implicit_conversion": "required",
    "no_hidden_flow": "required",
    "no_goto": "required",
    "no_recursion": "required",
    "misra_c_2012": "required"
  },
  "test_design": {
    "requirements_analysis": "required",
    "equivalence_classes": "required",
    "boundary_values": "required",
    "error_guessing": "recommended",
    "interface_test": "required",
    "fault_injection": "required"
  },
  "coverage": {
    "statement": {
      "level": "recommended",
      "min": 100
    },
    "branch": {
      "level": "required",
      "min": 100
    },
    "mcdc": {
      "level": "required",
      "min": 100
    }
  },
  "static_analysis": {
    "level": "recommended",
    "tool": "cppcheck",
    "fail_on": "warning"
  },
  "timing": {
    "call_period_ms": 10
  }
}
