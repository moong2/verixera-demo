      "source": "SW-003",
      "acceptance_criteria": [
        "센서 유효성 플래그 = False이고 온도 25.0 °C이면 입력 무효",
        "센서 유효성 플래그 = False이고 온도가 범위 밖이어도 입력 무효"
      ],
      "ltl": "□(¬sensor_valid_flag → input_invalid)",
      "ltl_text": "G(!sensor_valid_flag -> input_invalid)",
      "content_hash": "sha256:f98ec7f6b0f656d5acb11f8d50800cd24e420d2ca61aeb25782de33a7f9a4f07"
